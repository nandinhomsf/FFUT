# Copie para .env e preencha:  cp .env.example .env
# O .env e lido pelo Spring (spring.config.import) e pelo docker compose. NUNCA faca commit dele.

# Chave de assinatura do JWT (base64, >= 32 bytes). Gere com: openssl rand -base64 48
JWT_SIGNATURE_KEY=
JWT_EXPIRATION=1440

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ffut

# RabbitMQ (usado tambem pelo docker-compose.yml)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tuff
RABBITMQ_PASSWORD=

# E-mail transacional (Resend)
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# URLs
APPLICATION_DOMAIN=http://localhost:8080
FRONTEND_DOMAIN=http://localhost:4200/#
FRONTEND_URL=http://localhost:4200/#/
